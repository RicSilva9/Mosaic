{
  "name": "mosaic",
  "version": "0.1.0",
  "description": "A social platform for discovering, creating, customizing and remixing AI video prompts.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev": "pnpm --parallel --filter web --filter api run '/^(dev|start:dev)$/'",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "test": "pnpm --filter api test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}